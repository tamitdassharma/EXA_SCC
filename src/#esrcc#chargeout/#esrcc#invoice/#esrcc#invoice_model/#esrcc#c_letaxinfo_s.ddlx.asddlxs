@Metadata.layer: #CUSTOMER
@UI: {
  headerInfo: {
    typeName: 'VAT/Sales Tax Rate'
  }
}
annotate view /ESRCC/C_LeTaxInfo_S with
{
  @UI.facet: [ {
    id: 'Transport', 
    purpose: #STANDARD, 
    type: #IDENTIFICATION_REFERENCE, 
    label: 'Transport', 
    position: 1 , 
    hidden: #(HideTransport)
  }, 
  {
    id: '/ESRCC/I_LeTaxInfo',
    purpose: #STANDARD,
    type: #LINEITEM_REFERENCE,
    label: 'Maintain VAT/Sales Tax Rate',
    position: 2 ,
    targetElement: '_TaxInformation'
  } ]
  @UI.lineItem: [ {
    position: 1
  } ]
  SingletonID;

  @UI.hidden: true
  HideTransport;

  @UI.identification: [ {
    position: 2 , 
    importance: #HIGH
  }, 
  {
    type: #FOR_ACTION, 
    dataAction: 'SelectCustomizingTransptReq', 
    label: 'Select Transport'
  } ]
  TransportRequestID;
}