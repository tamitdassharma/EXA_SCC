@Metadata.layer: #CUSTOMER
@UI: {
  headerInfo: {
    typeName: 'Hierarchy Definition'
  }
}
annotate view /ESRCC/C_HierDef_S with
{
  @UI.facet: [ {
    id: 'Transport', 
    purpose: #STANDARD, 
    type: #IDENTIFICATION_REFERENCE, 
    label: 'Transport', 
    position: 1 , 
    hidden: #(HideTransport)
  }, 
  {
    id: '/ESRCC/I_HierDef', 
    purpose: #STANDARD, 
    type: #LINEITEM_REFERENCE, 
    label: 'Hierarchy Definition', 
    position: 2 , 
    targetElement: '_HierDef'
  } ]
  @UI.lineItem: [ { position: 1 } ]
  SingletonID;
  
  @UI.hidden: true
  HideTransport;
  
  @UI.identification: [ {
    position: 2 , 
    importance: #HIGH
  }, 
  {
    type: #FOR_ACTION, 
    dataAction: 'SelectCustomizingTransptReq', 
    label: 'Select Transport'
  } ]
  TransportRequestID;
}