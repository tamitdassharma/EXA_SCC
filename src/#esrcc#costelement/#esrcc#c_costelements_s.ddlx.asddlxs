@Metadata.layer: #CORE
@UI: {
  headerInfo: {
    typeName: 'Cost Element'
  }
}
annotate view /ESRCC/C_CostElements_S with
{
  @UI.facet: [ {
    id: 'Transport', 
    purpose: #STANDARD, 
    type: #IDENTIFICATION_REFERENCE, 
    label: 'Transport', 
    position: 1 , 
    hidden: #(HideTransport)
  },
  {
    id: '/ESRCC/I_CostElements',
    purpose: #STANDARD,
    type: #PRESENTATIONVARIANT_REFERENCE,
    label: 'Maintain Cost Elements',
    position: 2 ,
    targetQualifier: 'pVariant',
    targetElement: '_CostElements'
  } ]
  @UI.lineItem: [ {
    position: 1
  } ]
  SingletonID;

  @UI.hidden: true
  HideTransport;

  @UI.identification: [ {
    position: 2 , 
    importance: #HIGH
  }, 
  {
    type: #FOR_ACTION, 
    dataAction: 'SelectCustomizingTransptReq', 
    label: 'Select Transport'
  } ]
  TransportRequestID;
}