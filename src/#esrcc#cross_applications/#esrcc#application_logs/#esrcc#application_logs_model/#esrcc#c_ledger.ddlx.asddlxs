@Metadata.layer: #CUSTOMER
@UI: {
  headerInfo: {
    typeName: 'Ledger',
    typeNamePlural: 'Ledgers',
    title: {
      type: #STANDARD,
      value: 'Ledger'
    }
  }
}
annotate view /ESRCC/C_Ledger with
{
  @UI.facet: [ {
    id: 'CE',
    type: #COLLECTION,
    position: 1
  },
  {
    id: '/ESRCC/I_LEDGER',
    purpose: #STANDARD,
    type: #IDENTIFICATION_REFERENCE,
    parentId: 'CE',
    label: 'General Information',
    position: 10
  },
  {
    id: 'Admin',
    purpose: #STANDARD,
    type: #FIELDGROUP_REFERENCE,
    parentId: 'CE',
    targetQualifier: 'AdminGroup',
    label: 'Admin Information',
    position: 20
  },
  {
    id: '/ESRCC/I_LedgerText',
    type: #LINEITEM_REFERENCE,
    parentId: 'CE',
    position: 30,
    targetElement: '_LedgerText'
  } ]

  @UI.lineItem: [ { position: 1 },
                  { type: #FOR_ACTION, dataAction: 'Copy', label: 'Copy', invocationGrouping: #CHANGE_SET, position: 10 } ]
  Ledger;

  @UI.identification: [ { position: 3 } ]
  @UI.lineItem: [ { position: 3, cssDefault.width: '4.5rem' } ]
  Active;

  @UI.lineItem: [ { position: 4 } ]
  @UI.fieldGroup: [{ position: 1, qualifier: 'AdminGroup' }]
  CreatedBy;

  @UI.lineItem: [ { position: 5, cssDefault.width: '9.5rem' } ]
  @UI.fieldGroup: [{ position: 2, qualifier: 'AdminGroup' }]
  CreatedAt;

  @UI.lineItem: [ { position: 6  } ]
  @UI.fieldGroup: [{ position: 3, qualifier: 'AdminGroup' }]
  LastChangedBy;

  @UI.lineItem: [{ position: 7, cssDefault.width: '9.5rem' }]
  @UI.fieldGroup: [{ position: 4, qualifier: 'AdminGroup' }]
  LastChangedAt;

  @UI.lineItem: [ { position: 2 } ]
  Description;
}