@Metadata.layer: #CUSTOMER
@UI: {
  headerInfo: {
    typeName: 'Ledger'
  }
}
annotate view /ESRCC/C_Ledger_S with
{
  @UI.facet: [ {
    id: 'Transport',
    purpose: #STANDARD,
    type: #IDENTIFICATION_REFERENCE,
    label: 'Transport',
    position: 1 ,
    hidden: #(HideTransport)
  },
  {
    id: '/ESRCC/I_Ledger',
    purpose: #STANDARD,
    type: #LINEITEM_REFERENCE,
    label: 'Maintain Ledgers',
    position: 2 ,
    targetElement: '_Ledger'
  } ]
  @UI.lineItem: [ {
    position: 1
  } ]
  SingletonID;

  @UI.hidden: true
  HideTransport;

  @UI.identification: [ {
    position: 2 ,
    importance: #HIGH
  },
  {
    type: #FOR_ACTION,
    dataAction: 'SelectCustomizingTransptReq',
    label: 'Select Transport'
  } ]
  TransportRequestID;
}