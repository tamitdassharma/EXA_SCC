  headerInfo: {
    typeName: 'Company Code'
  }
}
annotate view /ESRCC/C_LeCcode_S with
{
  @UI.facet: [ {
    id: '/ESRCC/I_LeCcode', 
    purpose: #STANDARD, 
    type: #LINEITEM_REFERENCE, 
    label: 'Maintain & Assign Company Codes', 
    position: 2 , 
    targetElement: '_LeToCompanyCode'
  } ]
  @UI.lineItem: [ {
    position: 1 
  } ]
  SingletonID;
  
  @UI.hidden: true
  HideTransport;
  
  @UI.identification: [ {
    position: 2 , 
    importance: #HIGH
  } ]
  TransportRequestID;
}