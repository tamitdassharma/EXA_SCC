managed with additional save implementation in class /ESRCC/BP_I_TPPROFILE_S unique;
strict;
with draft;

define behavior for /ESRCC/I_TpProf_S alias TpProfileAll
draft table /esrcc/d_tppro_s
with unmanaged save
lock master total etag LastChangedAtMax
authorization master ( global )

{
  field ( readonly )
  SingletonID;

  update;
  internal create;
  internal delete;

  draft action ( features : instance ) Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;
  action ( features : instance ) SelectCustomizingTransptReq parameter D_SelectCustomizingTransptReqP result [1] $self;

  association _TpProfile { create ( features : instance, precheck ); with draft; }
}

define behavior for /ESRCC/I_TpProf alias TpProfile
persistent table /esrcc/tpprof
draft table /esrcc/d_tpprof
etag master LocalLastChangedAt
lock dependent by _TpProfileAll
authorization dependent by _TpProfileAll

{
  field ( mandatory : create )
  Tpprofile;

  field ( readonly )
  SingletonID,
  CreatedBy,
  CreatedAt,
  LastChangedBy,
  LastChangedAt,
  LocalLastChangedAt;

  field ( readonly : update )
  Tpprofile;

  update ( features : global );
  delete ( features : global );

  factory action ( features : instance ) Copy parameter /ESRCC/D_CopyTpProfP [1];

  mapping for /esrcc/tpprof
    {
      Tpprofile          = TPPROFILE;
      CreatedBy          = CREATED_BY;
      CreatedAt          = CREATED_AT;
      LastChangedBy      = LAST_CHANGED_BY;
      LastChangedAt      = LAST_CHANGED_AT;
      LocalLastChangedAt = LOCAL_LAST_CHANGED_AT;
    }

  association _TpProfileAll { with draft; }
  association _TpProfileText { create ( features : global ); with draft; }

  validation ValidateTransportRequest on save ##NOT_ASSIGNED_TO_DETACT { create; update; delete; }
}

define behavior for /ESRCC/I_TpProfText alias TpProfileText
persistent table /esrcc/tpproft
draft table /esrcc/d_tpproft
etag master LocalLastChangedAt
lock dependent by _TpProfileAll
authorization dependent by _TpProfileAll

{
  field ( mandatory : create )
  Spras;

  field ( readonly )
  SingletonID,
  Tpprofile,
  LocalLastChangedAt;

  field ( readonly : update )
  Spras;


  update ( features : global );
  delete ( features : global );

  mapping for /esrcc/tpproft
    {
      Spras              = SPRAS;
      Tpprofile          = TPPROFILE;
      Description        = DESCRIPTION;
      LocalLastChangedAt = LOCAL_LAST_CHANGED_AT;
    }

  association _TpProfileAll { with draft; }
  association _TpProfile { with draft; }

  validation ValidateTransportRequest on save ##NOT_ASSIGNED_TO_DETACT { create; update; delete; }
}