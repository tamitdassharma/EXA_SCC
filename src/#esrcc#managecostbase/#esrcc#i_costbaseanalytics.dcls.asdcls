@EndUserText.label: 'Acces Control for Manage Costbase'
@MappingRole: true
define role /ESRCC/I_COSTBASEANALYTICS {
    grant select on /ESRCC/I_COSTBASEANALYTICS
      where (Legalentity) = aspect pfcg_auth('/ESRCC/LE', /ESRCC/LE, ACTVT = '03') AND
      (Costobject,Costcenter) = aspect pfcg_auth('/ESRCC/CO', /ESRCC/OBJ, /ESRCC/CN, ACTVT = '03');                      
}