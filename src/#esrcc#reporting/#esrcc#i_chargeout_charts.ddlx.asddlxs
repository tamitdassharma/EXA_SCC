  @Consumption.valueHelpDefinition: [{ entity: { name: '/ESRCC/I_SystemInformation_F4', element: 'SystemId' } }]
  @UI.lineItem: [{ position: 130 } ]
  @UI.textArrangement: #TEXT_LAST
  ReceiverSysId;
  @UI.lineItem: [{ position: 140 } ]
  @UI.selectionField: [{position: 100}]
  @UI.textArrangement: #TEXT_LAST
