{
    qualifier: 'ChartDefault',
    chartType: #COLUMN,
    dimensions:  ['Legalentity','Ryear' ],
    measures:  [ 'TotalChargeOutAmount' ],
    dimensionAttributes: [
    {
        dimension: 'Ryear',
        role:  #CATEGORY
    },
    {
        dimension: 'Legalentity',
        role: #CATEGORY
    }

    ],
    measureAttributes: [{
        measure: 'TotalChargeOutAmount',
        role: #AXIS_1
    }]
}

