projection implementation in class /ESRCC/BP_C_LICENSE_S unique;
strict;
use draft;

define behavior for /ESRCC/C_License_S alias LicenseAll

{
  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;
  use action SelectCustomizingTransptReq;

  use association _License { create ( augment ); with draft; }
}

define behavior for /ESRCC/C_License alias License

{
  field ( modify )
  Description;

  use update ( augment );
  use delete;

  use action Copy;

  use association _LicenseAll { with draft; }
  use association _LicenseText { create; with draft; }
}

define behavior for /ESRCC/C_LicenseText alias LicenseText

{
  use update;
  use delete;

  use association _LicenseAll { with draft; }
  use association _License { with draft; }
}