@EndUserText.label: 'Access Control for /ESRCC/C_RoyaltyBaseValue'
@MappingRole: true
define role /ESRCC/C_ROYALTYBASEVALUE {
    grant
        select
            on
                /ESRCC/C_ROYALTYBASEVALUE
                    where
                        inheriting conditions from entity /ESRCC/I_ROYALTYBASEVALUE;
}