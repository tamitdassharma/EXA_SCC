@EndUserText.label: 'Acces Control for Royalty'
@MappingRole: true
define role /ESRCC/I_DETERMINE_ROYALTY {
    grant select on /ESRCC/I_DETERMINE_ROYALTY
      where (LicenseeLegalentity) = aspect pfcg_auth('/ESRCC/LE',  ACTVT = '03', /ESRCC/LE) AND
      (LicenseeCostobject,LicenseeCostcenter) = aspect pfcg_auth('/ESRCC/CO', /ESRCC/OBJ, /ESRCC/CN, ACTVT = '03');    
}