managed with additional save implementation in class /ESRCC/BP_I_SRVMKP_S unique;
strict;
with draft;

define behavior for /ESRCC/I_SrvMkp_S alias ServiceMarkupAll
draft table /esrcc/d_srvmk_s
with unmanaged save
lock master total etag LastChangedAtMax
authorization master ( global )

{
  update;
  internal create;
  internal delete;

  draft action ( features : instance ) Edit;
  draft action Activate;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare
  {
    validation ServiceMarkup~ValidateData;
  }

  association _ServiceMarkup { create ( features : instance, precheck ); with draft; }
}

define behavior for /ESRCC/I_SrvMkp alias ServiceMarkup
persistent table /esrcc/srvmkp
draft table /esrcc/d_srvmkp
etag master LocalLastChangedAt
lock dependent by _ServiceMarkupAll
authorization dependent by _ServiceMarkupAll

{
  field ( mandatory : create )
  Serviceproduct,
  Validfrom;

  field ( mandatory )
  Validto;

  field ( readonly )
  WorkflowId, WorkflowStatus, Comments,
  SingletonID, CreatedBy, CreatedAt, LastChangedBy, LastChangedAt;

  field ( readonly : update )
  Serviceproduct,
  Validfrom;

  update ( features : instance, precheck );
  delete ( features : instance );

  mapping for /ESRCC/SRVMKP
  {
    Serviceproduct = SERVICEPRODUCT;
    Validfrom = VALIDFROM;
    Origcost = ORIGCOST;
    Passcost = PASSCOST;
    IntraOrigcost = INTRA_ORIGCOST;
    IntraPasscost = INTRA_PASSCOST;
    Validto = VALIDTO;
    WorkflowId = WORKFLOW_ID;
    WorkflowStatus = WORKFLOW_STATUS;
    CommentId = COMMENT_ID;
    CreatedBy = CREATED_BY;
    CreatedAt = CREATED_AT;
    LastChangedBy = LAST_CHANGED_BY;
    LastChangedAt = LAST_CHANGED_AT;
    LocalLastChangedAt = LOCAL_LAST_CHANGED_AT;
  }

  association _ServiceMarkupAll { with draft; }

  action ( features : instance ) Submit parameter /ESRCC/C_COMMENT result [1] $self;
  action ( features : instance ) Finalize result [1] $self;
  action ( features : instance ) Reopen result [1] $self;

  determination UpdateInternalWorkflowStatus on modify { field Origcost, Passcost, IntraOrigcost, IntraPasscost, Validto; }
  determination UpdateWorkflowStatus on save { field WorkflowInternalStatus; }
  determination UpdateComment on save { field Comments; }
  determination TriggerWorkflow on save { field WorkflowStatus; }

  validation ValidateData on save ##NOT_ASSIGNED_TO_DETACT { create; update; }
}